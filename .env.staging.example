APP_NAME="Flujo Caja Pyme"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL="https://STAGING_HOST"

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=CPANEL_DB_HOST
DB_PORT=3306
DB_DATABASE=CPANEL_DB_NAME
DB_USERNAME=CPANEL_DB_USER
DB_PASSWORD=CPANEL_DB_PASSWORD

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_ABSOLUTE_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

TRUSTED_PROXIES=CPANEL_TRUSTED_PROXIES
TRUSTED_PROXY_HEADERS=HEADER_X_FORWARDED_PROTO

BOOTSTRAP_COMPANY_NAME="Empresa Staging"
BOOTSTRAP_COMPANY_CODE=STAGING
BOOTSTRAP_ADMIN_NAME="Administrador inicial"
BOOTSTRAP_ADMIN_EMAIL="admin@STAGING_HOST"
BOOTSTRAP_ADMIN_PASSWORD="DEFINE_THIS_OUTSIDE_GIT"
