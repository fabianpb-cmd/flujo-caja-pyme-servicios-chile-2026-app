APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Cloud hardening reference (staging/production)
# APP_ENV=staging
# APP_DEBUG=false
# APP_URL=https://staging.example.com
# BOOTSTRAP_COMPANY_NAME=Empresa Staging
# BOOTSTRAP_COMPANY_CODE=STAGING
# BOOTSTRAP_ADMIN_NAME=Administrador inicial
# BOOTSTRAP_ADMIN_EMAIL=admin@staging.example.com
# BOOTSTRAP_ADMIN_PASSWORD=use-a-secret-from-your-operator-or-secret-manager

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=flujo_caja_pyme
DB_USERNAME=root
DB_PASSWORD=
# Optional: set a stable local-only password for the demo admin user.
UAT_ADMIN_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=30
SESSION_EXPIRE_ON_CLOSE=true
SESSION_ABSOLUTE_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cloud / proxy / HTTPS
# TRUSTED_PROXIES=10.0.0.10,10.0.0.11
# TRUSTED_PROXY_HEADERS=HEADER_X_FORWARDED_AWS_ELB
# SECURITY_HSTS_ENABLED=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
